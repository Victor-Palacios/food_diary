# Copy to .env.local and fill in. Never commit the filled-in copy.
#
# Everything in this file is inlined into the client bundle by Vite at build
# time. That is true whether the value comes from here or from a Cloudflare
# build variable -- a bundler-inlined value is public, full stop. Only the two
# keys below belong here, and both are designed to be public.
#
# A genuine secret (the NVIDIA API key, a service_role key) must NEVER appear
# in this file. Those are Worker secret bindings -- see .dev.vars.example.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase ANON / publishable key. Public by design.
#
# This key is safe ONLY because Row Level Security is enabled on every table
# and every policy scopes rows to auth.uid(). With RLS off it would be an
# unrestricted read/write credential published in your JavaScript. Never put
# the service_role key here -- it bypasses RLS entirely.
VITE_SUPABASE_ANON_KEY=

# Single fixed timezone that defines the day boundary for `eaten_on`.
# Defaults to America/Los_Angeles when unset.
VITE_TIMEZONE=America/Los_Angeles
