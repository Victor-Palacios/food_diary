{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "food-log",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // One Worker serves both the SPA and the API. Static assets in ./dist are
  // matched first; `run_worker_first` carves out /api/* so those requests
  // reach the script instead of 404ing against the asset manifest, and
  // `single-page-application` sends every other unmatched path to index.html
  // so client-side routes survive a hard refresh.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  },

  // Workers AI: the keyless last resort at the end of every model chain
  // (worker/models.ts). Runs inside Cloudflare, so it keeps photos working
  // when NVIDIA withdraws a model, is down, or rejects the key.
  "ai": {
    "binding": "AI"
  },

  // Non-secret Worker config. The NVIDIA API key is NOT here -- it is a secret
  // binding set with `wrangler secret put NVIDIA_API_KEY` (see README).
  //
  // Which models to try, and in what order, lives in worker/models.ts, chosen
  // by probing /api/diag rather than by reading NVIDIA's catalog. To change
  // the order without a code change, set a comma-separated list here:
  //   "NVIDIA_VISION_MODELS": "meta/llama-3.2-90b-vision-instruct, ..."
  //   "NVIDIA_TEXT_MODELS": "z-ai/glm-5.3-flash, ..."
  // A single pinned model used to live here and went dead when NVIDIA
  // withdrew it; that is exactly what the chain is for.
  "vars": {
    "NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1"
  }
}
